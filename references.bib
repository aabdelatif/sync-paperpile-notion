@ARTICLE{Taguchi2010-mv,
  title    = "Genetic Analysis of Cytoprotective Functions Supported by Graded
              Expression of {Keap1}",
  author   = "Taguchi, Keiko and Maher, Jonathan M and Suzuki, Takafumi and
