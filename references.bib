@ARTICLE{Miklas2022-wy,
  title    = "Amino acid primed {mTOR} activity is essential for heart
              regeneration",
  author   = "Miklas, Jason W and Levy, Shiri and Hofsteen, Peter and Mex, Diego
              Ic and Clark, Elisa and Muster, Jeanot and Robitaille, Aaron M and
