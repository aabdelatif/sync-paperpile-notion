@ARTICLE{Petriello2018-yl,
  title    = "Dioxin-like {PCB} 126 Increases Systemic Inflammation and
              Accelerates Atherosclerosis in Lean {LDL} Receptor-Deficient Mice",
  author   = "Petriello, Michael C and Brandon, J Anthony and Hoffman, Jessie
