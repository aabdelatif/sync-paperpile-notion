@MISC{Iversen2020-ge,
  title    = "Elevated {suPAR} Is an Independent Risk Marker for Incident Kidney
              Disease in Acute Medical Patients",
  author   = "Iversen, Esben and Houlind, M B and Kallemose, T and Rasmussen, L
              and Hornum, M and Feldt-Rasmussen, B and Hayek, S and Andersen, O
