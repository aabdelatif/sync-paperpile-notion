  journal  = "Arterioscler. Thromb. Vasc. Biol.",
  volume   =  39,
  number   =  11,
  pages    = "2261--2272",
  abstract = "Objective: Genome-wide association studies identified novel loci
              in PLPP3 (phospholipid phosphatase 3) that associate with coronary
