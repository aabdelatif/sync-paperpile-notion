@ARTICLE{Leng2022-ww,
  title    = "Ion channel {Piezo1} activation promotes aerobic glycolysis in
              macrophages",
  author   = "Leng, Shaoqiu and Zhang, Xiaoyu and Wang, Shuwen and Qin, Jing and
