@ARTICLE{Afshinnia2018-fx,
  title    = "Impaired β-Oxidation and Altered Complex Lipid Fatty Acid
              Partitioning with Advancing {CKD}",
  author   = "Afshinnia, Farsad and Rajendiran, Thekkelnaycke M and Soni, Tanu
