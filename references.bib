@ARTICLE{Peng2021-ia,
  title    = "Adult spiny mice (Acomys) exhibit endogenous cardiac recovery in
              response to myocardial infarction",
  author   = "Peng, Hsuan and Shindo, Kazuhiro and Donahue, Renée R and Gao,
