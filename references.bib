  year     =  2022,
  language = "en"
}

@MISC{Wu2018-yi,
  title    = "Soluble Urokinase Plasminogen Activator Receptor is Associated
              with Coronary Artery Calcification and Cardiovascular Disease in
              Patients Undergoing Hemodialysis",
  author   = "Wu, Wenjuan and Cui, Yanhai and Hu, Juan and Liao, Ruyi and Li,
