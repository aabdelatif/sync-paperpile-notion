@ARTICLE{Liu2019-xc,
  title    = "Fate Mapping via {Ms4a3}-Expression History Traces
              Monocyte-Derived Cells",
  author   = "Liu, Zhaoyuan and Gu, Yaqi and Chakarov, Svetoslav and Bleriot,
              Camille and Kwok, Immanuel and Chen, Xin and Shin, Amanda and
