  journal   = "NMR Biomed.",
  publisher = "Wiley",
  volume    =  32,
  number    =  6,
  pages     = "e4096",
  abstract  = "The pentose phosphate pathway (PPP) is essential for reductive
               biosynthesis, antioxidant processes and nucleotide production.
               Common tracers such as [1,2-13 C2 ]glucose rely on detection of
               13 C in lactate and require assumptions to correct natural 13 C
               abundance. Here, we introduce a novel and specific tracer of the
               PPP, [2,3-13 C2 ]glucose. 13 C NMR analysis of the resulting
               isotopomers is informative because [1,2-13 C2 ]lactate arises
               from glycolysis and [2,3-13 C2 ]lactate arises exclusively
               through the PPP. A correction for natural abundance is
               unnecessary. In rats receiving [2,3-13 C2 ]glucose, the PPP was
               more active in the fed versus fasted state in the liver and the
               heart, consistent with increased expression of key enzymes in the
               PPP. Both the PPP and glycolysis were substantially increased in
               hepatoma compared with liver. In summary, [2,3-13 C2 ]glucose and
               13 C NMR simplify assessment of the PPP.",
  month     =  jun,
  year      =  2019,
  keywords  = "NADPH; NMR; glucose 6-phosphate dehydrogenase; glycolysis;
               hepatoma; lactate; ribose; stable isotope",
  language  = "en"
}

