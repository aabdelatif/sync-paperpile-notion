@ARTICLE{Anker2021-ob,
  title     = "Empagliflozin in heart failure with a preserved ejection fraction",
  author    = "Anker, Stefan D and Butler, Javed and Filippatos, Gerasimos and
               Ferreira, João P and Bocchi, Edimar and Böhm, Michael and
               Brunner-La Rocca, Hans-Peter and Choi, Dong-Ju and Chopra, Vijay
