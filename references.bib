  journal   = "J. Mol. Cell. Cardiol.",
  publisher = "Elsevier BV",
  volume    =  182,
  pages     = "1--14",
  abstract  = "Diabetes enhances myocardial ischemic/reperfusion (MI/R) injury
               via an incompletely understood mechanism. Adiponectin (APN) is a
               cardioprotective adipokine suppressed by diabetes. However, how
               hypoadiponectinemia exacerbates cardiac injury remains
