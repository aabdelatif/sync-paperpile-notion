@ARTICLE{Paulus2013-lv,
  title     = "A novel paradigm for heart failure with preserved ejection
               fraction: comorbidities drive myocardial dysfunction and
               remodeling through coronary microvascular endothelial
               inflammation",
  author    = "Paulus, Walter J and Tschöpe, Carsten",
  journal   = "J. Am. Coll. Cardiol.",
