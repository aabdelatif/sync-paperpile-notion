@MISC{noauthor_undated-lg,
  title    = "Bradshaw-Myocardial Fibrosis During Hemodynamic Load
              Unload-Reversible vs Persistent Fibroblast Activation copy",
  abstract = "Specific Aims Nonischemic cardiomyopathy leading to chronic heart
              failure (CHF) with a reduced ejection fraction (HFrEF) is
              characterized by increased morbidity, mortality, and clinical
              disability, abnormal cardiac structure \& function including
              interstitial myocardial fibrosis (IMF). Despite remarkable
              advances in therapies, significant residual clinical risk and
              disability continue to be present. One potential target for
              development of new therapies remains the unmet ability to reduce
              IMF. The principal myocardial cell type that determines
              structure/composition of the extracellular matrix (ECM) is the
              cardiac fibroblast. We hypothesize that a persistently activated
              fibroblast phenotype seen in HFrEF is a primary determinant of
              sustained IMF that impedes successful treatment of CHF. Novel,
              effective, antifibrotic therapies can only be developed when
              fundamental cellular mechanisms that sustain IMF can be
              identified. Studies proposed in this application will aim to
              define these mechanisms and design approaches to modify fibroblast
              phenotype to ameliorate IMF in VA patients with CHF."
}

@MISC{noauthor_undated-xb,
  title    = "Grant-Cao Myocardial ischemia-trained neutrophils accelerate
              breast cancer progression by modifying the tumor microenvironment
              copy",
  abstract = "Acute myocardial infarction (MI) induces profound changes in the
              innate immune system. Our group recently reported that MI enhances
              the effector functions of bone marrow neutrophils, including
              cytokine production, receptor signaling, chemotaxis, and
              degranulation, along with a marked increase in neutrophil
              production by up to tenfold[1]. While these changes are striking,
              the broader consequences of MIinduced immune reprogramming,
              particularly its impact on cancer pathogenesis and progression,
              remain poorly understood. Emerging evidence suggests a link
              between ischemic heart disease and breast cancer progression[2-5].
              This connection has often been attributed to shared risk factors
              such as smoking, obesity, and chronic inflammation, largely due to
              the absence of mechanistic studies. However, recent findings
              indicate that myocardial ischemia itself may directly accelerate
              cancer progression[6-8], raising the possibility of a causal
              relationship between MI and tumor growth."
}

@ARTICLE{Redfield2023-tm,
  title    = "Heart failure with preserved ejection fraction: A review",
  author   = "Redfield, Margaret M and Borlaug, Barry A",
  journal  = "JAMA",
  volume   =  329,
  number   =  10,
  pages    = "827--838",
  abstract = "Importance: Heart failure with preserved ejection fraction
              (HFpEF), defined as HF with an EF of 50\% or higher at diagnosis,
              affects approximately 3 million people in the US and up to 32
              million people worldwide. Patients with HFpEF are hospitalized
              approximately 1.4 times per year and have an annual mortality rate
              of approximately 15\%. Observations: Risk factors for HFpEF
              include older age, hypertension, diabetes, dyslipidemia, and
              obesity. Approximately 65\% of patients with HFpEF present with
              dyspnea and physical examination, chest radiographic,
              echocardiographic, or invasive hemodynamic evidence of HF with
              overt congestion (volume overload) at rest. Approximately 35\% of
              patients with HFpEF present with ``unexplained'' dyspnea on
              exertion, meaning they do not have clear physical, radiographic,
              or echocardiographic signs of HF. These patients have elevated
              atrial pressures with exercise as measured with invasive
              hemodynamic stress testing or estimated with Doppler
              echocardiography stress testing. In unselected patients presenting
              with unexplained dyspnea, the H2FPEF score incorporating clinical
              (age, hypertension, obesity, atrial fibrillation status) and
              resting Doppler echocardiographic (estimated pulmonary artery
              systolic pressure or left atrial pressure) variables can assist
              with diagnosis (H2FPEF score range, 0-9; score >5 indicates more
              than 95\% probability of HFpEF). Specific causes of the clinical
              syndrome of HF with normal EF other than HFpEF should be
              identified and treated, such as valvular, infiltrative, or
              pericardial disease. First-line pharmacologic therapy consists of
              sodium-glucose cotransporter type 2 inhibitors, such as
              dapagliflozin or empagliflozin, which reduced HF hospitalization
              or cardiovascular death by approximately 20\% compared with
              placebo in randomized clinical trials. Compared with usual care,
              exercise training and diet-induced weight loss produced clinically
              meaningful increases in functional capacity and quality of life in
              randomized clinical trials. Diuretics (typically loop diuretics,
              such as furosemide or torsemide) should be prescribed to patients
              with overt congestion to improve symptoms. Education in HF
              self-care (eg, adherence to medications and dietary restrictions,
              monitoring of symptoms and vital signs) can help avoid HF
              decompensation. Conclusions and Relevance: Approximately 3 million
              people in the US have HFpEF. First-line therapy consists of
              sodium-glucose cotransporter type 2 inhibitors, exercise, HF
              self-care, loop diuretics as needed to maintain euvolemia, and
              weight loss for patients with obesity and HFpEF.",
  month    =  mar,
  year     =  2023,
  language = "en"
}

