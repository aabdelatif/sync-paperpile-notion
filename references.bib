@ARTICLE{Pepin2025-kq,
  title    = "Mitochondrial {NNT} Promotes Diastolic Dysfunction in
              Cardiometabolic {HFpEF}",
  author   = "Pepin, Mark E and Konrad, Philipp J M and Nazir, Sumra and Bazgir,
              Farhad and Maack, Christoph and Nickel, Alexander and Gorman,
